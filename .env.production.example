# Production template for Hostinger shared hosting.
# Copy to .env on the server, fill in every <...> value, then run
# `php artisan key:generate` once. See docs/deployment.md.

APP_NAME=AfraaCMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-domain.com>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One log file per day, kept for 14 days, errors only.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# hPanel > Databases > MySQL Databases. Hostinger prefixes the database
# name and user with your account id, e.g. u123456789_afraacms.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_afraacms>
DB_USERNAME=<u123456789_afraacms>
DB_PASSWORD=<database-password>

# The first Super Admin login, created by `php artisan db:seed`. Seeding
# refuses to run in production with a blank or "password" password.
# Remove these three lines from .env once you have logged in.
SUPER_ADMIN_NAME="<Your Name>"
SUPER_ADMIN_EMAIL=<you@example.com>
SUPER_ADMIN_PASSWORD=<long-unique-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing is queued today; "sync" means anything queued later runs
# immediately instead of waiting for a worker shared hosting doesn't have.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# hPanel > Emails: create a mailbox (e.g. no-reply@your-domain.com) and use
# its address and password here.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=<no-reply@your-domain.com>
MAIL_PASSWORD=<mailbox-password>
MAIL_FROM_ADDRESS="<no-reply@your-domain.com>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
